post_install() {
  echo "==> ymux is installed. Each user sets it up once with:"
  echo "==>     ymux install"
  echo "==> Before removing the package, run 'ymux uninstall' as each user."
}

post_upgrade() {
  echo "==> ymux upgraded. Run 'ymux install' again to load the new version."
}

pre_remove() {
  echo "==> Run 'ymux uninstall' as each user who installed it, if not done yet:"
  echo "==> it removes ~/.config/hypr/ymux.lua, its require line and the bar plugin."
}
